# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Core ---
ENV=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
SESSION_COOKIE_SECURE=false
# In production (real HTTPS domain) set SESSION_COOKIE_SECURE=true

# --- Database ---
# Local Docker Compose default:
DATABASE_URL=postgresql+psycopg://lifeos:lifeos_dev_password@postgres:5432/lifeos

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS / Frontend ---
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Email (leave blank to disable email sending; app will log instead of failing) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@lifeos.local

# --- AI Assistant (leave blank to disable; endpoints will return "not configured") ---
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Voice (STT/TTS providers; leave blank to disable Voice entirely) ---
STT_PROVIDER_API_KEY=
TTS_PROVIDER_API_KEY=

# --- Frontend-only (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
